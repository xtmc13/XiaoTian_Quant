# ═══════════════════════════════════════════════════════════════════
# XiaoTianQuant Environment Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── Security ──────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: encrypt any persisted non-secret config fields (AES-256-GCM).
# When unset, config.yaml stores non-secret fields only in plaintext.
# XIAOTIAN_CONFIG_KEY=

# ── Server ────────────────────────────────────────────────────────
BACKEND_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Frontend (Vite) ───────────────────────────────────────────────
# When the frontend runs independently, point it at the gateway.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_HOST=localhost:8080

# ── Database ──────────────────────────────────────────────────────
DB_TYPE=sqlite
DATABASE_URL=sqlite:///data/xtquant.db
# PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/xtquant

# ── Redis (optional, for caching) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379

# ── Proxy (VPN — needed for Binance API from China) ───────────────
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ── Exchange API Keys ─────────────────────────────────────────────
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=false

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Gate.io
GATE_API_KEY=
GATE_API_SECRET=
GATE_TESTNET=false

# ── AI / LLM Providers ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=

ANTHROPIC_API_KEY=

# ── Notifications ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=XiaoTianQuant <noreply@xtquant.com>

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 短信通知（Twilio，不配则 SMS 渠道禁用；凭据与 Telegram bot token 同等待遇，env/保险库注入）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
# Prometheus 指标（默认启用；可配 token 鉴权或仅允许 localhost）
PROMETHEUS_ENABLED=true
# PROMETHEUS_TOKEN=
# PROMETHEUS_LOCALHOST_ONLY=false

# ── Alertmanager 告警推送（observability profile；详见 docs/OBSERVABILITY.md）──
# 共享密钥：gateway /api/alerts/webhook 的 X-Alert-Webhook-Secret 校验值，
# gateway 与 alertmanager 容器两侧必须同值；空则 webhook 端点 fail-closed（503）。
ALERT_WEBHOOK_SECRET=
# 网关 webhook 地址（默认 compose 网络内服务名；网关跑宿主机时改为
# http://host.docker.internal:8080/api/alerts/webhook）
# ALERT_GATEWAY_WEBHOOK_URL=http://gateway:8080/api/alerts/webhook
# critical 告警直连邮件（可选；配齐 ALERT_EMAIL_TO 才启用，独立于上面的 SMTP_*）
ALERT_SMTP_HOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# critical 告警直连 Telegram（可选；配齐 ALERT_TELEGRAM_BOT_TOKEN 才启用，
# ALERT_TELEGRAM_CHAT_ID 必须是纯数字，如 -1001234567890）
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── ML Server ─────────────────────────────────────────────────────
ML_SERVER_URL=http://localhost:8001

# ── Paper Trading ─────────────────────────────────────────────────
# 默认强制模拟交易，实盘需要显式解锁
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_BALANCE=100000
PAPER_TRADING_FEE_RATE=0.001
PAPER_TRADING_SLIPPAGE=0.0005

# ── Live Trading Safety ───────────────────────────────────────────
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM_REQUIRED=true

# ── Risk Management ───────────────────────────────────────────────
MAX_POSITION_PCT=0.3
MAX_LEVERAGE=5
MAX_DAILY_LOSS_PCT=5.0
MAX_CONSECUTIVE_LOSSES=5
CIRCUIT_BREAKER_ENABLED=true

# ── Billing 支付计费 ──────────────────────────────────────────────
# USDT 收款地址（按链配置，未配置的链不会出现在前端支付选项里）
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
USDT_ERC20_ADDRESS=
USDT_SOL_ADDRESS=

# 链上核验密钥
# TronGrid（TRC20）可选，配置后带 TRON-PRO-API-KEY 头提升限额
TRONGRID_API_KEY=
# BscScan（BEP20）必填：不配则该链订单核验直接失败
BSCSCAN_API_KEY=
# Etherscan（ERC20）必填：不配则该链订单核验直接失败
ETHERSCAN_API_KEY=
# Solana 公共 RPC 可换自建节点（默认 https://api.mainnet-beta.solana.com）
SOLANA_RPC_URL=

# Stripe 信用卡支付（不配置则整个通道禁用，前端不显示信用卡按钮）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook 签名密钥（Stripe 后台 Endpoint 里的 Signing secret），不配则 webhook 拒绝服务
STRIPE_WEBHOOK_SECRET=
# 订单核验轮询间隔（秒，默认 30）
# BILLING_VERIFY_INTERVAL=30

# ── 外部数据生态（/api/dataproviders/*）──
# 恐惧贪婪指数(Alternative.me)/新闻(CryptoCompare)/热力图(自算)/经济日历均免 key；
# 以下两个源不配 key 时自动降级为 not_configured（API 正常返回，不报错）。
# Coinglass 衍生品情绪（资金费率/多空比/爆仓），申请: https://www.coinglass.com/pricing
COINGLASS_API_KEY=
# FRED 美国宏观序列（联邦基金利率/CPI/M2/失业率/国债收益率），申请: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
